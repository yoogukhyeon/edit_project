{
  "routes": [
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://www.fullayer.com/$1",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
